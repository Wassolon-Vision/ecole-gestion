rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function hasProfile() {
      return request.auth != null
        && exists(/databases/$(db)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data;
    }
    function active() { return hasProfile() && profile().actif == true; }
    function isDirection() { return active() && profile().role == 'direction'; }
    function isStaff() { return active() && profile().role in ['direction', 'enseignant']; }
    function firstRun() { return !exists(/databases/$(db)/documents/config/ecole); }

    // Informations générales de l'école
    match /config/ecole {
      allow read: if true;
      allow create: if request.auth != null && firstRun();
      allow update: if isDirection();
    }

    // Compteur des matricules
    match /config/compteur {
      allow read, write: if isDirection();
    }

    // Profils des utilisateurs
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isDirection());
      allow create: if isDirection()
        || (request.auth != null && request.auth.uid == uid && firstRun()
            && request.resource.data.role == 'direction');
      allow update, delete: if isDirection();
    }

    // Élèves : le personnel voit tout, un parent ne voit que son enfant
    match /students/{id} {
      allow read: if isStaff()
        || (active() && profile().role == 'parent' && profile().eleveId == id);
      allow create, update, delete: if isDirection();
    }

    // Classes : le personnel voit, la direction modifie
    match /classes/{id} {
      allow read: if active();
      allow write: if isDirection();
    }

    // Enseignants : le personnel voit, la direction modifie
    match /teachers/{id} {
      allow read: if isStaff();
      allow write: if isDirection();
    }

    // Notes : la direction saisit, le personnel voit, un parent ne voit que son enfant
    match /grades/{id} {
      allow read: if isStaff()
        || (active() && profile().role == 'parent' && id.matches(profile().eleveId + '_[123]'));
      allow write: if isDirection();
    }

    // Frais : la direction gère, un parent voit les paiements de son enfant
    match /payments/{id} {
      allow read: if isDirection()
        || (active() && profile().role == 'parent' && resource.data.eleveId == profile().eleveId);
      allow write: if isDirection();
    }

    // Absences : le personnel fait l'appel, un parent voit celles de son enfant
    match /absences/{id} {
      allow read: if isStaff()
        || (active() && profile().role == 'parent' && resource.data.eleveId == profile().eleveId);
      allow write: if isStaff();
    }
    match /appel/{id} {
      allow read, write: if isStaff();
    }

    // Discipline : le personnel ajoute, la direction modifie
    match /discipline/{id} {
      allow read, create: if isStaff();
      allow update, delete: if isDirection();
    }

    // Réclamations : un parent dépose et suit les siennes, la direction traite
    match /claims/{id} {
      allow read: if isDirection()
        || (active() && profile().role == 'parent' && resource.data.eleveId == profile().eleveId);
      allow create: if isDirection()
        || (active() && profile().role == 'parent'
            && request.resource.data.eleveId == profile().eleveId
            && request.resource.data.st == 'Nouvelle');
      allow update, delete: if isDirection();
    }

    // Annonces, discussions et emplois du temps
    match /annonces/{id} {
      allow read: if active();
      allow write: if isDirection();
    }
    match /threads/{id} {
      allow read, write: if active() && (request.auth.uid == id || isDirection());
    }
    match /edt/{id} {
      allow read: if active();
      allow write: if isDirection();
    }

    // Journal des modifications
    match /journal/{id} {
      allow read: if isDirection();
      allow create: if isStaff();
    }

    // Codes d'accès : visibles seulement par la direction
    match /codes/{id} {
      allow read, write: if isDirection();
    }
  }
}
